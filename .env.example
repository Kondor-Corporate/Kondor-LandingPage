VITE_FORMSPREE_FORM_ID=your_form_id_here
# Optional alternative:
# VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id_here

# Analytics / measurement
# Prefer GTM in production. If GTM is set, GA4 direct loading is skipped.
VITE_GTM_ID=
VITE_GA4_MEASUREMENT_ID=

# Search Console verification token. See docs/env-vars.md before adding it to index.html.
VITE_GOOGLE_SITE_VERIFICATION=

# Optional during Fases 0/1. Enable after Supabase and the server-side endpoint exist.
# VITE_LEAD_INGESTION_ENDPOINT=/api/leads

# Supabase Postgres via Prisma
# Runtime connection string. In deployed serverless environments, prefer Supabase's pooled connection URL.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct database URL for Prisma migrations. Use the direct/session connection string from Supabase.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
